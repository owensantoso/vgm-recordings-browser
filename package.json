{
  "name": "vgm-recordings-browser",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run catalog && node scripts/build.mjs --serve",
    "build": "npm run catalog && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/catalog.test.mjs tests/practice-store.test.mjs && node scripts/test-ui.mjs && npm run test:browser",
    "test:browser": "node --test tests/browser.test.mjs tests/practice-visuals.browser.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "catalog": "node --experimental-strip-types scripts/catalog.mjs",
    "build:private": "npm run catalog && node scripts/build.mjs --private-audio"
  },
  "dependencies": {
    "@soundtouchjs/core": "2.1.1",
    "lucide-react": "1.52.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "playwright-core": "1.63.0",
    "typescript": "5.9.3"
  }
}
