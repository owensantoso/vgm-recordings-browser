{
  "name": "vgm-recordings-browser",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "node scripts/build.mjs --serve",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts && node scripts/test-ui.mjs && npm run test:browser",
    "test:browser": "node --test tests/browser.test.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "playwright-core": "1.63.0",
    "typescript": "5.9.3"
  }
}
